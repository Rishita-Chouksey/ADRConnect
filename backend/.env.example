# Copy to .env and supply deployment-specific values. Do not commit .env.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/adrconnect
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Required only when running src/config/seed.py.
SEED_USER_PASSWORD=replace-with-a-temporary-local-seed-password
