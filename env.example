# Copy this file to .env.local and replace the placeholder values.

# PostgreSQL connection string (Neon, Supabase, Railway, or any managed Postgres).
# Prisma reads this directly — no other config file needed at this Prisma version.
DATABASE_URL="postgresql://user:password@host:5432/adr_trace?schema=public"

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Comma-separated Google account email addresses that can create ADR reports.
# All other signed-in accounts receive the doctor (read-only) role.
NURSE_EMAILS=nurse1@hospital.example,nurse2@hospital.example
